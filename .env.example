# Banco de dados (docker compose up -d sobe este Postgres)
DATABASE_URL="postgresql://kg:kg@localhost:5432/kg?schema=public"

# Providers externos.
# Até a fase 8, TUDO roda contra mock: nenhuma fase de F0 a F7 precisa de conta,
# chave ou rede. Ver fases/contexto-comum.md §5.
PAYMENT_PROVIDER="mock"
MESSAGING_PROVIDER="mock"
BILLING_PROVIDER="mock"

# Console de desenvolvimento (/dev/outbox e /dev/payments), criado na F0.3.
# Bloqueado fora de desenvolvimento no servidor.
NODE_ENV="development"

# Secret do endpoint de cron (expiração de holds, envio de lembretes)
CRON_SECRET="troque-em-producao"
