# Banco de dados (docker compose up -d sobe este Postgres)
# Runtime da aplicação: role SEM superuser, para que a Row Level Security valha
# também em desenvolvimento. Superuser ignora RLS, e aí a segunda camada de
# isolamento fica inerte justamente onde o código é escrito.
DATABASE_URL="postgresql://kg_app:kg_app@localhost:5432/kg?schema=public"

# Dono do banco: migrations, seed e criação da role de aplicação.
DIRECT_DATABASE_URL="postgresql://kg:kg@localhost:5432/kg?schema=public"

# Providers externos.
# Até a fase 8, TUDO roda contra mock: nenhuma fase de F0 a F7 precisa de conta,
# chave ou rede. Ver fases/contexto-comum.md §5.
PAYMENT_PROVIDER="mock"
MESSAGING_PROVIDER="mock"
BILLING_PROVIDER="mock"

# Console de desenvolvimento (/dev/outbox e /dev/payments), criado na F0.3.
# Bloqueado fora de desenvolvimento no servidor.
NODE_ENV="development"

# Token que o webhook /api/webhooks/payments exige no header `asaas-access-token`.
# É o mesmo mecanismo do Asaas (token fixo, não HMAC). O mock usa este secret
# para assinar o POST que dispara em si mesmo (contexto-comum.md §5.2).
PAYMENTS_WEBHOOK_SECRET="dev-webhook-secret"

# Chave-mestra da aplicação (KEK) que cifra, por envelope, a chave de API da
# subconta Asaas de cada estabelecimento (tarefa F4.1). A chave da subconta
# NUNCA é gravada em texto puro: se o banco vazar, vaza ciphertext.
# Base64 de 32 bytes. Gere com: openssl rand -base64 32
# Em produção é obrigatória (a aplicação falha explícito sem ela); em
# desenvolvimento há um fallback local, o mesmo critério do AUTH_SESSION_SECRET.
# PAYMENTS_ENCRYPTION_KEY=""

# URL que o mock usa para disparar o webhook em si mesmo (contexto-comum.md §5.2).
# Resolução, nesta ordem: host da requisição atual → PAYMENTS_WEBHOOK_URL →
# APP_URL → PORT. Sem nenhuma delas, o mock falha com erro explícito em vez de
# entregar no endereço errado em silêncio.
# PAYMENTS_WEBHOOK_URL="http://127.0.0.1:3000/api/webhooks/payments"
# APP_URL="http://127.0.0.1:3000"

# Billing B2B da plataforma (F7.0). O mock assina o webhook com HMAC-SHA256 no
# header `stripe-signature`, o mesmo mecanismo do Stripe; a F7.2 usa este secret
# para verificar na rota /api/webhooks/billing e a F8.1 troca só quem assina.
# Em produção é obrigatório (sem fallback de desenvolvimento).
BILLING_WEBHOOK_SECRET="dev-billing-webhook-secret"

# URL que o mock de billing usa para disparar o webhook em si mesmo
# (contexto-comum.md §5.2). Mesma resolução do mock de pagamentos: host da
# requisição atual → BILLING_WEBHOOK_URL → APP_URL → PORT.
# BILLING_WEBHOOK_URL="http://127.0.0.1:3000/api/webhooks/billing"

# IP público usado como origem do remoteIp do pagador SOMENTE quando
# NODE_ENV=development (em dev a requisição chega de loopback e o Asaas real
# recusaria). Em produção a variável é ignorada: vale o IP extraído do header da
# requisição, com o mesmo guard. Precisa ser um IP PÚBLICO de verdade: as faixas
# de documentação (192.0.2.0/24, 198.51.100.0/24, 203.0.113.0/24) são recusadas
# de propósito, porque o guard de dev é o mesmo de produção. Não "conserte" isto
# trocando por um IP de documentação — a recusa é o comportamento correto.
# DEV_PAYER_IP="8.8.8.8"

# Secret do endpoint de cron (expiração de holds, envio de lembretes)
CRON_SECRET="troque-em-producao"

# Domínio base do SaaS, usado pela F1.0 para separar subdomínio de tenant
# (carlosbarber.APP_DOMAIN) de domínio próprio (qualquer outro host). Se
# ausente, a resolução usa o host de APP_URL; em produção, configure um dos
# dois — sem isso a resolução falha com erro explícito em vez de classificar
# todo host como domínio próprio. Ajuste a porta se rodar o dev em outra.
APP_DOMAIN="localhost:3000"

# Segredo que assina o cookie de sessão kg_session (HMAC-SHA256), usado pela
# F1.0. Em produção é obrigatório (a aplicação falha explícito sem ele); em
# desenvolvimento há um valor de fallback. Gere com: openssl rand -base64 32
AUTH_SESSION_SECRET="dev-session-secret-troque-em-producao"

# Taxa da plataforma sobre cobranças B2C, em pontos-base (1000 = 10%).
# Pontos-base e não percentual decimal: o split é calculado em centavos e
# qualquer decimal no caminho gera diferença de arredondamento que ninguém
# consegue explicar depois.
# VALOR PROVISÓRIO — o percentual real é decisão de produto pendente
# (plano-refatoracao.md §9, item 2).
PLATFORM_FEE_BASIS_POINTS="1000"

# Carteira da plataforma que recebe o split. A cobrança nasce na SUBCONTA do
# estabelecimento e o split traz só a taxa para cá; o Asaas recusa split
# apontando para a carteira de quem cria a cobrança.
PLATFORM_WALLET_ID="mock-platform-wallet"

# Silêncio noturno dos lembretes (tarefa F6.1). Horas LOCAIS do tenant: um
# lembrete que cairia dentro da janela é empurrado para o fim dela; se o fim já
# é depois do atendimento começar (H-2 das 4h para um horário das 6h), ele não é
# enviado. Sem as duas variáveis — ou com valor inválido — vale o padrão 21h–8h.
# Definir as duas iguais (ex.: 0 e 0) desliga o silêncio.
# A promoção a configuração POR TENANT depende de coluna nova em `Tenant` e é
# decisão de schema da F6.2/F2.5, não desta tarefa.
# NOTIFICATION_QUIET_START_HOUR="21"
# NOTIFICATION_QUIET_END_HOUR="8"
