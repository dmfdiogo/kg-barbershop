{
  "$schema": "https://opencode.ai/config.json",
  "model": "deepseek/deepseek-flash",
  "small_model": "deepseek/deepseek-flash",
  "disabled_providers": [
    "h2o-litellm",
    "opencode",
    "ollama"
  ],
  "permission": {
    "bash": {
      "*": "allow",
      "git push*": "deny",
      "git filter-repo*": "deny",
      "git filter-branch*": "deny",
      "git config --global*": "deny",
      "npm publish*": "deny",
      "gh repo delete*": "deny",
      "gh repo edit*": "deny",
      "gh secret*": "deny",
      "rm -rf /*": "deny",
      "rm -rf ~*": "deny",
      "rm -rf ..*": "deny",
      "git merge*": "ask",
      "git rebase --onto*": "ask",
      "git reset --hard*": "ask",
      "git clean -f*": "ask",
      "git worktree remove*": "ask",
      "git branch -D*": "ask",
      "git tag -d*": "ask",
      "gh pr merge*": "ask",
      "dropdb*": "ask",
      "rm -rf *": "allow",
      "rm -r *": "allow",
      "rm -r /*": "deny",
      "rm -r ~*": "deny",
      "rm -r ..*": "deny"
    },
    "external_directory": "ask"
  }
}
